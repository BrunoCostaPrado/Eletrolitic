{
	"name": "@redbruno/eletrolitic",
	"version": "0.1.0",
	"description": "TypeScript compiler powered by Rust",
	"main": "dist/ferrite.mjs",
	"types": "dist/ferrite.d.mts",
	"exports": {
		".": {
			"types": "./dist/ferrite.d.mts",
			"default": "./dist/ferrite.mjs"
		}
	},
	"bin": {
		"eletrolitic": "./bin/eletrolitic.cjs"
	},
	"files": [
		"dist/**/*",
		"bin/**/*"
	],
	"engines": {
		"node": ">=16"
	},
	"scripts": {
		"build": "tsdown",
		"lint": "biome check --write .",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"typescript",
		"compiler",
		"rust"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BrunoCostaPrado/Basalt.git"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"author": "",
	"license": "ISC",
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/node": "^26.1.1",
		"tsdown": "^0.22.13",
		"typescript": "^5.7.3"
	}
}