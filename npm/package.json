{
	"name": "@redbruno/eletrolitic",
	"version": "0.1.2",
	"description": "TypeScript compiler powered by Rust",
	"keywords": [
		"typescript",
		"compiler",
		"rust"
	],
	"homepage": "https://github.com/BrunoCostaPrado/Ferrite#readme",
	"bugs": {
		"url": "https://github.com/BrunoCostaPrado/Ferrite/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BrunoCostaPrado/Ferrite.git"
	},
	"license": "ISC",
	"author": "RedBruno",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/eletrolitic.d.mts",
			"default": "./dist/eletrolitic.mjs"
		}
	},
	"main": "dist/eletrolitic.mjs",
	"types": "dist/eletrolitic.d.mts",
	"bin": {
		"eletrolitic": "bin/eletrolitic.cjs"
	},
	"files": [
		"dist/**/*",
		"bin/**/*"
	],
	"scripts": {
		"build": "tsdown",
		"lint": "biome check --write .",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/node": "^26.1.1",
		"tsdown": "^0.22.13",
		"typescript": "^5.7.3"
	},
	"engines": {
		"node": ">=16"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
